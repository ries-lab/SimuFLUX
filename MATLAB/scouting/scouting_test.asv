t=(0:0.5:10)';
pos0=[150,0];
N=10; %total photons
repetitions=1000;
R=200;
sigma=100;
pos=scanpos(t,R);
psftot=sum(PSF(pos,pos0,sigma));
countrate=N/psftot;


%% least squares fitting
postot=zeros(repetitions,2);
for k=1:repetitions
    inten=poissrnd(countrate*PSF(pos,pos0,sigma));
    ft = fittype(@(x0,y0,countrate,t) sqrt(scanpsf(t,x0,y0,countrate,R,sigma)), ...
        'independent','t', ...
        'coefficients', {'x0','y0','countrate'});
    
    mdl = fit(t,sqrt(inten), ft,'StartPoint',[0,0,]);
    postot(k,1)=mdl.x0;
    postot(k,2)=mdl.y0;
end


figure(88)
subplot(2,2,1)
hold off
plot(t,inten)
hold on
plot(t,mdl(t).^2)
title([mdl.x0, mdl.y0, sum(inten)])
subplot(2,2,2)
plot(pos(:,1),pos(:,2),pos0(1),pos0(2),'x',mdl.x0,mdl.y0,'o')

disp("mean "+mean(postot,1)+", std " + std(postot,1))

%%

function intensity=scanpsf(t,x0,y0,countrate,R,sigma)
intensity=countrate*PSF(scanpos(t,R),[x0, y0],sigma);
end

function intensity=PSF(pos,pos0,sigma)
intensity=exp(-sum((pos-pos0).^2,2)/2/sigma^2);
end

function pos=scanpos(t,par)
R=par(1);
pos(:,1)=R*sin(1*t);
% pos(:,2)=R*cos(t);
pos(:,2)=R*(t)/2.5-2*R;
end